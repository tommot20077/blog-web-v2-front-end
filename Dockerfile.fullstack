# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.fullstack — 本地全端整併驗證用前端映像
#
# 與既有 ./Dockerfile 的唯一差異：接受 build arg VITE_API_BASE_URL，於 build 前
# 寫入 .env.production.local（Vite 對 production mode 的最高優先 env 檔），藉此把
# API base 從正式的 https://90030.xyz 覆寫為本地後端（預設 http://localhost:9010）。
#
# 為何用 .env.production.local 而非 build arg 直接餵 process.env：
#   Vite 對「VITE_」前綴變數的來源以 .env 檔為主，於映像內生成此檔最穩定可預期，
#   且 .dockerignore 排除的是「複製進來的」*.local，這裡是 build 階段內生成，不受影響。
#
# 既有 ./Dockerfile（prod：直接 bake .env.production=https://90030.xyz）完全不動。
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: build
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# 本地後端位址；compose 以 build.args 覆寫（瀏覽器在 host，故指 host 對外埠）。
ARG VITE_API_BASE_URL=http://localhost:9010

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# 將 build arg 寫入 production mode 的最高優先 env 檔，覆蓋 .env.production。
RUN printf 'VITE_USE_MOCK=false\nVITE_API_BASE_URL=%s\n' "$VITE_API_BASE_URL" > .env.production.local \
    && echo "[fullstack] VITE_API_BASE_URL=$VITE_API_BASE_URL" \
    && npm run build

# ---------------------------------------------------------------------------
# Stage 2: runtime — nginx 靜態站（沿用既有 nginx.conf）
# ---------------------------------------------------------------------------
FROM nginx:alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
